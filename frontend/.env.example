# Frontend public settings (these values are exposed to the browser).
# Create an application at https://dashboard.clerk.com and use its development publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Optional separate backend origin. By default, Vite proxies API and Socket.IO to localhost:3001.
# VITE_API_URL=http://localhost:3001/api
# VITE_DEV_PROXY_TARGET=http://localhost:3001
