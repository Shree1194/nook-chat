PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Use a local MongoDB service, or provide your MongoDB Atlas URI.
MONGO_URI=mongodb://127.0.0.1:27017/nook_chat

# Copy from your Clerk Dashboard (API keys). Required for auth and the chat APIs.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Optional: configure a Clerk webhook endpoint at /api/webhooks/clerk to sync profiles.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_your_clerk_webhook_signing_secret

# Optional: ImageKit private key is required for image/video uploads.
IMAGEKIT_PRIVATE_KEY=private_replace_with_your_imagekit_private_key
